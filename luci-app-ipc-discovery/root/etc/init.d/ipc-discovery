#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/ipc-discovery

start_service() {
	config_load ipc-discovery
	config_get interface main interface br-lan
	config_get probe_interval main probe_interval 30
	config_get scan_wait main scan_wait 5
	config_get online_window main online_window 60
	config_get cache_ttl main cache_ttl 300
	config_get max_entries main max_entries 4096
	config_get oui_file main oui_file /etc/ipc-discovery/oui-camera.txt

	procd_open_instance
	procd_set_param command "$PROG" \
		--daemon \
		--interface "$interface" \
		--probe-interval "$probe_interval" \
		--scan-wait "$scan_wait" \
		--online-window "$online_window" \
		--cache-ttl "$cache_ttl" \
		--max-entries "$max_entries" \
		--oui-file "$oui_file"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/ipc-discovery
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger ipc-discovery
}
